{
  "name": "campus-lost-found",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "seed": "npm run seed -w server",
    "test": "npm test -w server",
    "test:integration": "npm run test:integration -w server",
    "verify:db": "npm run verify:db -w server",
    "test:semantic": "npm run test:semantic -w server",
    "model:prepare": "npm run model:prepare -w server",
    "migrate": "npm run migrate -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18.20"
  }
}
