MONGODB_URI=mongodb://localhost:27017/campus_lost_found
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Replace with a long random secret (at least 32 characters).
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
# First use downloads a CPU sentence model; later use is cached locally.
MATCH_EMBEDDINGS=true
MATCH_LOCAL_FILES_ONLY=false
